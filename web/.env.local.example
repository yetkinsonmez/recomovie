# Copy to .env.local and fill in your Supabase project values.
# Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Mixedbread API key for embedding vibe queries.
# Dashboard -> API Keys: https://www.mixedbread.com
MIXEDBREAD_API_KEY=mxb_your_key_here

# Canonical site origin, no trailing slash. Used for sitemap.xml, robots.txt,
# canonical URLs and JSON-LD. On Vercel this is auto-derived from VERCEL_URL if
# unset, but set it explicitly in production to your real domain.
NEXT_PUBLIC_SITE_URL=https://recomovie.tv
